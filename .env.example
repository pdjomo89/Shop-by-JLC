# --- Site ---
NEXT_PUBLIC_SITE_URL=https://shopbyjlc.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CONTACT_EMAIL=info@shopbyjlc.com

# --- Stripe (cards, all countries) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Create a recurring monthly EUR Price for each plan in the Stripe dashboard,
# then paste the price IDs here.
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx

# --- Campay (Orange Money + MTN MoMo, Cameroon) ---
# https://www.campay.net  (use demo.campay.net while testing)
CAMPAY_API_BASE=https://demo.campay.net/api
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_KEY=
# EUR -> XAF conversion rate used to bill mobile money (XAF is pegged ~656/€)
EUR_TO_XAF=656

# --- AI agent (ShopByJLC Coach) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-opus-4-7
ANTHROPIC_MODEL=

# --- Convex (database) ---
# Run `npx convex dev` once to provision a deployment; it writes the URL here.
NEXT_PUBLIC_CONVEX_URL=
# Used by `npx convex deploy` in CI (optional)
CONVEX_DEPLOY_KEY=

# --- Notifications (optional) ---
# If set, payment events and contact form messages are emailed via Resend.
# Otherwise events are logged only.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# Where contact form submissions go. Falls back to NOTIFY_EMAIL_TO if unset.
CONTACT_EMAIL_TO=

# --- Welcome email (subscription credentials) ---
# Sender address for the welcome email containing username/password.
# Falls back to NOTIFY_EMAIL_FROM if unset.
WELCOME_EMAIL_FROM=
# Where the welcome email tells customers to sign in.
PLATFORM_URL=https://www.shopbyjlc.com/
